# ---- Dependencies -------------------------------------------------------
node_modules/
.pnpm-store/
#  Lock file is NOT committed: the container / dev-container regenerate it on
#  every `npm install`. Canonical resolution is Linux, in-container.
front-end/package-lock.json

# ---- Build output ------------------------------------------------------
front-end/dist/
front-end/build/
*.tsbuildinfo

# ---- Vite / test caches ---------------------------------------------
.vite/
front-end/coverage/
*.local

# ---- scripts/check-docs.sh scratch --------------------------------
.docs-check-tmp/

# ---- Live Sass Compiler output (generated from .scss) -----------------
#  The app imports .scss through Vite; these files are a standalone build for
#  inspection only. They land in one dedicated folder (Live Sass `savePath`)
#  whose contents are ignored but the folder itself is kept (.gitkeep). The
#  broad globs are a safety net — .css under src/ is always generated here.
front-end/app/_styles/css/*
!front-end/app/_styles/css/.gitkeep
front-end/app/**/*.css
front-end/app/**/*.css.map

# ---- Environment -----------------------------------------------------
docker/.env
.env
.env.*
!docker/.env.example
!.env.example

# ---- Editor / OS ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*

# ---- 3D source files (ship exported .glb/.gltf only) -----------------
*.blend
*.blend[0-9]
*.fbx
