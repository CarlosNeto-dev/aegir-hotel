# ---- Dependencies -------------------------------------------------------
node_modules/
.pnpm-store/
#  Lock file is NOT committed: the container / dev-container regenerate it on
#  every `pnpm install`. Canonical resolution is Linux, in-container.
app/pnpm-lock.yaml
#  Legacy npm lock from before the switch to pnpm - never commit it.
app/package-lock.json

# ---- Build output ------------------------------------------------------
app/dist/
app/build/
*.tsbuildinfo

# ---- Next.js build output & caches -----------------------------------
.next/
app/out/
next-env.d.ts

# ---- test caches -------------------------------------------------------
app/coverage/
*.local

# ---- scripts/check-docs.sh scratch --------------------------------
.docs-check-tmp/

# ---- Live Sass Compiler output (generated from .scss) -----------------
#  Legacy: unused since the move to Next (it compiles .scss itself); these files were a standalone build for
#  inspection only. They land in one dedicated folder (Live Sass `savePath`)
#  whose contents are ignored but the folder itself is kept (.gitkeep). The
#  broad globs are a safety net — .css under src/ is always generated here.
app/src/styles/css/*
!app/src/styles/css/.gitkeep
app/src/**/*.css
app/src/**/*.css.map

# ---- Environment -----------------------------------------------------
docker/.env
.env
.env.*
!docker/.env.example
!.env.example

# ---- Editor / OS ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
pnpm-debug.log*

# ---- 3D source files (ship exported .glb/.gltf only) -----------------
*.blend
*.blend[0-9]
*.fbx
