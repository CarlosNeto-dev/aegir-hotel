# =============================================================================
#  .env.example · copy to `.env` in THIS folder (docker/) and adjust as needed
#      cd docker && cp .env.example .env
#  Docker Compose loads `.env` from the compose file's directory automatically.
#  This is the ONLY place to change image versions and host<->container ports.
# =============================================================================

# ---- Runtime -------------------------------------------------------------
NODE_VERSION=24

# ---- Build stage target  (base | debugger | build | production) --------
FRONTEND_TARGET=debugger

# ---- Paths -------------------------------------------------------------
APP_DIR=/app

# ---- Ports  (host = container) ---------------------------------------
WEB_DEV_PORT=5173          # website — Next.js dev server (Fast Refresh)
WEB_PREVIEW_PORT=4173      # website — reserved for a production-like preview (unused today)
NODE_DEBUG_PORT=9229       # debug   — Node.js inspector
