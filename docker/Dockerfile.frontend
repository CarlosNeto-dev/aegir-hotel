# syntax=docker/dockerfile:1

# =============================================================================
#  Dockerfile.frontend - Aegir Hotel web client
# -----------------------------------------------------------------------------
#  Stack served by this image:
#    - Next.js (App Router) + React + TypeScript (application code)
#    - SCSS                        (styling, compiled natively by Next)
#    - GSAP                        (animation)
#    - react-three-fiber / three   (3D scenes - added later)
#    - Blender-exported .glb/.gltf (3D assets - added later)
#
#  Multi-stage layout (each stage is a `--target` you can build):
#
#    base        Only the Node.js runtime + WORKDIR. The single place the
#                Node version is defined; every other stage builds FROM it.
#
#    debugger    base + debuggers and diagnostic tooling.
#                This is the image used for local development and CI.
#
#    build       Helper stage. Compiles the Next.js app with output: "standalone"
#                (see front-end/next.config.ts). Never shipped - only its
#                .next/standalone + .next/static + public are copied forward.
#
#    production  Lean image: the Node.js runtime + the standalone server.js
#                Next.js builds for you. No pnpm, no nginx, no sources.
#
#  Build examples:
#    docker build -f docker/Dockerfile.frontend --target debugger  -t aegir-web:dev  .
#    docker build -f docker/Dockerfile.frontend --target production -t aegir-web:prod .
# =============================================================================


# -----------------------------------------------------------------------------
#  Global build arguments - override from docker-compose.yml, .env or --build-arg.
#  Declared once here; each stage re-declares the ones it uses because Docker
#  resets the ARG scope at every FROM.
# -----------------------------------------------------------------------------
ARG NODE_VERSION=24
ARG NODE_IMAGE=node:${NODE_VERSION}-bookworm-slim
ARG APP_DIR=/app

#  Network ports - kept in one place so the Dockerfile, docker-compose.yml and
#  .devcontainer/devcontainer.json all agree on the same numbers:
#    WEB_DEV_PORT      5173   website  - Next.js dev server (Fast Refresh)
#    WEB_PREVIEW_PORT  4173   website  - reserved for a production-like preview (unused today)
#    WEB_PROD_PORT     3000   website  - the standalone Next.js server in the production image
#    NODE_DEBUG_PORT   9229   debug    - Node.js inspector (chrome://inspect)
ARG WEB_DEV_PORT=5173
ARG WEB_PREVIEW_PORT=4173
ARG WEB_PROD_PORT=3000
ARG NODE_DEBUG_PORT=9229


# =============================================================================
#  Stage 1 - base
#  Nothing but the Node.js runtime and the working directory.
# =============================================================================
FROM ${NODE_IMAGE} AS base

ARG APP_DIR
WORKDIR ${APP_DIR}

# Sane defaults inherited by every downstream stage.
ENV NODE_ENV=development \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

# pnpm is the package manager. Corepack (bundled with Node 24) provides the
# `pnpm` shim and fetches the exact version pinned in the "packageManager" field
# of front-end/package.json on first use - the version is NOT defined here.
RUN corepack enable


# =============================================================================
#  Stage 2 - debugger
#  Same base image, plus everything needed to run and debug the app.
#  Used by docker-compose (the `website` service) and by CI.
# =============================================================================
FROM base AS debugger

# --- OS-level tools handy when shelling into a running container --------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        procps \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# --- Global Node.js helpers on PATH -----------------------------------------
#  Only truly project-agnostic helpers go here. These two global CLIs are
#  installed with the `npm` bundled in the Node image (not upgraded on
#  purpose); everything the app depends on goes through pnpm instead.
#  Dependency build scripts are decided in front-end/pnpm-workspace.yaml (allowBuilds).
RUN npm install -g \
        serve \
        source-map-explorer

# Re-declare the port args so EXPOSE can see them, and promote the runtime one
# to ENV so HEALTHCHECK (evaluated when the container runs) can read it too.
ARG WEB_DEV_PORT
ARG WEB_PREVIEW_PORT
ARG NODE_DEBUG_PORT

# Documented ports (numbers/purpose listed in the ARG block at the top):
#   website - Next.js dev server (Fast Refresh)
EXPOSE ${WEB_DEV_PORT}
#   website - reserved for a production-like preview (unused today)
EXPOSE ${WEB_PREVIEW_PORT}
#   debug   - Node.js inspector, attach from the host
EXPOSE ${NODE_DEBUG_PORT}

# Container-level liveness probe (docker-compose defines its own as well).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "process.exit(0)" || exit 1

# Overridden by docker-compose:
#   pnpm dev -H 0.0.0.0 -p WEB_DEV_PORT          -> website (serves WEB_DEV_PORT)
CMD ["pnpm", "run", "dev"]


# =============================================================================
#  Stage 3 - build (helper, not shipped)
#  Produces the standalone Next.js output in /app/.next.
#  Requires front-end/package.json. Until it exists, build only the `debugger`
#  target above.
# =============================================================================
FROM base AS build

# Copy the manifest first so the install layer stays cached until deps change.
# No lock file is committed (it is regenerated per environment), so this is a
# resolving `pnpm install`, not `--frozen-lockfile`.
# NODE_ENV stays "development" (inherited from `base`) for this install: `sass`
# and `typescript` are devDependencies the build needs to compile .scss/.ts -
# setting NODE_ENV=production before `pnpm install` would skip them.
COPY front-end/package.json front-end/pnpm-workspace.yaml ./
RUN pnpm install

# Then the sources, and compile. `next build` sets its own production mode
# internally - no need to export NODE_ENV here either.
COPY front-end/ ./
RUN pnpm run build


# =============================================================================
#  Stage 4 - production
#  Lean runtime image: just Node.js + the standalone server `next build`
#  produces (front-end/next.config.ts has `output: "standalone"`). No pnpm, no
#  nginx, no sources - standalone bundles only the dependencies it traced.
# =============================================================================
FROM ${NODE_IMAGE} AS production

ARG APP_DIR
WORKDIR ${APP_DIR}

ARG WEB_PROD_PORT
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=${WEB_PROD_PORT}

# Standalone output does NOT include static assets or the public/ folder -
# Next.js expects those copied in next to server.js explicitly.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

# Run as the image's unprivileged user (uid 1000) - matches `debugger` /
# docker-compose / the dev-container, none of which run the app as root.
USER node

# website - the standalone Next.js server
EXPOSE ${WEB_PROD_PORT}

# bookworm-slim has no wget/curl here (those are only installed in `debugger`);
# Node 24 has a global `fetch`, so the probe stays dependency-free.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:' + process.env.PORT).then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
