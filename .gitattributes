# Normalize line endings on commit.
* text=auto

# Files consumed inside Linux containers / CI must stay LF regardless of host.
*.sh          text eol=lf
*.bash        text eol=lf
Dockerfile*   text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
.env*         text eol=lf
*.json        text eol=lf

# Binary assets — never touch.
*.png  binary
*.jpg  binary
*.gif  binary
*.glb  binary
*.gltf binary
*.woff binary
*.woff2 binary
